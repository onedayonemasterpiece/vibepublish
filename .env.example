# Supabase for shared Google AI limiter
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_KEY=
SUPABASE_SCHEMA=public

# Google AI Studio keys. Store key metadata in Supabase google_ai_api_keys;
# store secret values only in env/secret stores.
GOOGLE_API_KEY=
GOOGLE_API_LOCALNAME=

# Optional limiter/runtime controls
# GOOGLE_AI_ALLOW_RESERVE_FALLBACK=0
# GOOGLE_AI_LOCAL_LIMITER_FALLBACK=1
# GOOGLE_AI_LOCAL_RPM=15
# GOOGLE_AI_LOCAL_TPM=240000
# GOOGLE_AI_LOCAL_RPD=450
# GOOGLE_AI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemma-4-31b-it
# GOOGLE_AI_PROVIDER_TIMEOUT_SEC=120
# GOOGLE_AI_MAX_RETRIES=3

