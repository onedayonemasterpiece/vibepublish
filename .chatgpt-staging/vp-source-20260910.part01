+    async def test_new_uncertainty_reconciles_automatically_without_effect_replay(self):
+        receipt = await self.stuck()
+        self.provider.unknown = False
+        self.now += 6
+        await self.worker.run_once()
+        result = self.store.receipt(self.actor, receipt['operation_id'])
+        self.assertEqual(result['state'], 'verified', result)
+        self.assertTrue(result['operation_complete'])
+        self.assertEqual(self.provider.count('execute'), 1)
+        self.assertEqual(self.provider.count('effect'), 1)
+        self.assertEqual(self.provider.count('reconcile'), 2)  # execute readback + one recovery observation
+        self.assertNotEqual(result['state'], 'outcome_unknown')
+
+    async def test_new_reconciliation_survives_worker_restart_without_effect_replay(self):
+        receipt = await self.stuck()
+        self.provider.unknown = False
+        self.now += 6
+        restarted = Worker(Store(self.store.path, clock=lambda: self.now), {'max': self.provider})
+        await restarted.run_once()
+        result = self.store.receipt(self.actor, receipt['operation_id'])
+        self.assertEqual(result['state'], 'verified', result)
+        self.assertEqual(self.provider.count('execute'), 1)
+        self.assertEqual(self.provider.count('effect'), 1)
+        self.assertEqual(self.provider.count('reconcile'), 2)  # execute readback + one recovery observation
+
+    async def test_new_reconciliation_is_bounded_and_never_replays_effect(self):
+        receipt = await self.stuck()
+        for _ in range(10):
+            current = self.store.receipt(self.actor, receipt['operation_id'])
+            if current['operation_complete']:
+                break
+            self.now += 6
+            await self.worker.run_once()
+        result = self.store.receipt(self.actor, receipt['operation_id'])
+        self.assertEqual(result['state'], 'blocked', result)
+        self.assertTrue(result['operation_complete'])
+        self.assertEqual(result['error']['code'], 'recovery_exhausted')
+        self.assertFalse(result['retry_safe'])
+        self.assertEqual(result['next_action'], 'contact_owner')
+        self.assertEqual(self.provider.count('execute'), 1)
+        self.assertEqual(self.provider.count('effect'), 1)
+        self.assertEqual(self.provider.count('reconcile'), 6)  # initial readback + five bounded recovery reads
+        self.assertNotEqual(result['state'], 'outcome_unknown')
+
