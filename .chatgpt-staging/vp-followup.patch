+        # Store construction can happen concurrently in server/worker processes.
+        # SQLite busy_timeout does not make journal_mode transitions mutually exclusive,
+        # so serialize only one-time journal/schema initialization across processes.
+        init_lock = self.path.with_name(self.path.name + ".init.lock")
+        lock_fd = os.open(init_lock, os.O_CREAT | os.O_RDWR, 0o600)
+        os.chmod(init_lock, 0o600)
+        try:
+            fcntl.flock(lock_fd, fcntl.LOCK_EX)
+            with self.connection() as db:
+                version = db.execute("PRAGMA user_version").fetchone()[0]
+                if version not in (0, 1, 2, 3, 4, 5):
+                    raise RuntimeError("Unsupported VibePublish database version")
+                journal_mode = str(db.execute("PRAGMA journal_mode").fetchone()[0]).lower()
+                if journal_mode != "wal":
+                    journal_mode = str(db.execute("PRAGMA journal_mode=WAL").fetchone()[0]).lower()
+                    if journal_mode != "wal":
+                        raise RuntimeError("VibePublish database requires WAL journal mode")
+                if version == 0:
