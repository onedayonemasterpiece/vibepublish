+    async def legacy_stuck(self, targets=None):
+        """Model an already-persisted pre-migration terminal record without rewriting production history."""
+        receipt = await self.stuck(targets)
+        legacy = OutcomeUnknown('receipt_lost').output()
+        with self.store.tx() as db:
+            db.execute("UPDATE attempts SET state='outcome_unknown',stage='outcome_unknown',observed='unknown' WHERE operation_id=? AND state='reconciling'",
+                       (receipt['operation_id'],))
+            db.execute("UPDATE operations SET state='outcome_unknown',complete=1,work_state='done',lease_until=0,error=? WHERE id=?",
+                       (canonical(legacy), receipt['operation_id']))
+        projected = self.store.receipt(self.actor, receipt['operation_id'])
+        self.assertEqual(projected['state'], 'outcome_unknown')
+        self.assertEqual(projected['next_action'], 'review_outcome')
+        self.assertFalse(projected['retry_safe'])
         return receipt
 
