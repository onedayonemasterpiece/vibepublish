+                # Historical terminal uncertainty remains readable, but never becomes
+                # retryable. New uncertainty is non-terminal reconciliation and likewise
+                # forbids replay. Known no-effect failures may expose explicit retry data.
+                if state == "outcome_unknown":
+                    result["next_action"] = "review_outcome"
